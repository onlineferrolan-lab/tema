/* CHECKOUT*/
.js-cart-line-megaproduct-measure {
    color: #414141;
    background-color: #fff;
    height: 2.75rem;
    padding: .175rem .5rem;
    width: 4rem;
}

.mp-tab-steps .progressbar {
    counter-reset: step;
}

.mp-tab-steps .progressbar li {
    list-style-type: none;
    width: 25%;
    float: left;
    font-size: 22px;
    position: relative;
    text-align: center;
    text-transform: uppercase;
    color: #7d7d7d;
}

.mp-tab-steps .progressbar li:before {
    width: 45px;
    height: 45px;
    content: counter(step);
    counter-increment: step;
    line-height: 45px;
    border: 2px solid #7d7d7d;
    display: block;
    text-align: center;
    margin: 0 auto 10px auto;
    border-radius: 50%;
    background-color: white;
}

.mp-tab-steps .progressbar li:after {
    width: 100%;
    height: 2px;
    content: '';
    position: absolute;
    background-color: #7d7d7d;
    top: 25px;
    left: -50%;
    z-index: -1;
}

.mp-tab-steps .progressbar li:first-child:after {
    content: none;
}

.mp-tab-steps .progressbar li.active {
    color: green;
}

.mp-tab-steps .progressbar li.active:before {
    border-color: #55b776;
}

.mp-tab-steps .progressbar li.active+li:after {
    background-color: #55b776;
}

.mp-tab-steps {
    padding: 18px;
    float: left;
    width: 100%;
    display: block;
}

